{
  "expo": {
    "name": "Expose2_MINEX_2023020202",
    "slug": "expose2-minex-2023020202",
    "githubUrl": "https://github.com/antonionanange-alt/toni",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "minexterrain",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.minex.expose2_2023020202",
      "adaptiveIcon": {
        "backgroundColor": "#0B2B28",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "MINEX Terrain utilise la caméra pour documenter les équipements.",
          "microphonePermission": "MINEX Terrain utilise le microphone pour les notes vocales.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "MINEX Terrain accède aux contacts pour importer les techniciens."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MINEX Terrain associe votre position GPS aux rapports d’intervention."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "MINEX Terrain enregistre les notes vocales des interventions.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B2B28",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4a468601-9698-4a4e-952c-9ed866ff3aba"
      }
    },
    "owner": "essentiel"
  }
}
